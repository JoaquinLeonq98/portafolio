---
import Layout from '../layouts/Layout.astro';
import Redes from '../components/Redes.astro';
import Especial from '../components/Especial.astro';
import Tecnologys from '../components/Tecnologys.astro';
import Banner from '../components/Banner.astro';
import Form from '../components/Form.astro';
import Footer from '../components/Footer.astro';
import Projects from '../components/Projects.astro';
import SectionHeading from '../components/SectionHeading.astro';
---

<Layout title="Joaquín León Quero — Portafolio">
  <main id="contenido" tabindex="-1">
    <Banner />
    <Projects />

    <section class="scroll-mt-24 border-b border-white/5 py-16 md:py-24" id="sobre-mi">
      <div class="mx-auto max-w-6xl px-5 sm:px-6">
        <div class="grid gap-8 lg:grid-cols-[1fr_1.2fr] lg:gap-16">
          <SectionHeading title="Tecnología con contexto" eyebrow="Sobre mí"
            subtitle="Entender el problema es parte de construir una buena solución." />
          <div data-reveal-group class="space-y-5 text-base leading-8 text-slate-400">
            <p>Soy ingeniero en Gestión de TI por la UVEG. Mi experiencia combina banca, desarrollo de producto y despliegue de aplicaciones. En COPARMEX participé en una app con Flutter, publicada en Play Store y App Store.</p>
            <p>Me importa entender al negocio, colaborar con el equipo y dejar código que otra persona pueda mantener. Uso agentes de IA para explorar, revisar y documentar; las decisiones y la calidad pasan por revisión humana.</p>
            <p>Trabajo con Angular, NestJS, Node, Next.js, Astro, Flutter, Linux, Docker y nube. Sigo aprendiendo según lo que cada proyecto necesita.</p>
          </div>
        </div>
        <div class="mt-14">
          <Redes />
        </div>
      </div>
    </section>

    <section class="scroll-mt-24 py-16 md:py-24" id="servicios">
      <div class="mx-auto max-w-6xl px-5 sm:px-6">
        <SectionHeading
          eyebrow="Cómo puedo ayudarte"
          title="Servicios"
          subtitle="Enfoque en negocio y resultados: digitalización, producto a medida y acompañamiento. El detalle técnico lo ves en cada proyecto."
        />
        <Especial />
      </div>
    </section>

    <section class="scroll-mt-24 border-y border-white/5 bg-white/[0.02] py-16 md:py-24" id="stack">
      <div class="mx-auto max-w-6xl px-5 sm:px-6">
        <SectionHeading
          eyebrow="Herramientas"
          title="Stack principal"
          subtitle="Tecnologías que uso con frecuencia en producto, backend y despliegue."
        />
        <Tecnologys />
      </div>
    </section>

    <section class="scroll-mt-24 py-20 md:pb-12" id="contacto">
      <div class="mx-auto max-w-6xl px-5 sm:px-6">
        <SectionHeading
          eyebrow="Hablemos"
          title="Contacto"
          subtitle="Cuéntame tu idea, tu equipo o tu reto técnico. Respondo con propuesta y siguientes pasos."
        />
        <Form />
      </div>
      <Footer />
    </section>
  </main>
</Layout>
