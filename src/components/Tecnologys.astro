---
import { techStack } from '../data/techStack';
import TechStackTile from './TechStackTile.astro';
---

<ul data-reveal class="tech-grid grid grid-cols-2 gap-px overflow-hidden border border-line bg-line sm:grid-cols-3 lg:grid-cols-6">
  {techStack.map((item) => (
    <TechStackTile item={item} />
  ))}
</ul>
