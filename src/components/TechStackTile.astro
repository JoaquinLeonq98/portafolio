---
import { Image } from 'astro:assets';
import type { TechStackItem } from '../data/techStack';
import { isMonochromeIcon } from '../data/projectTech';
import StackIcon from './icons/StackIcon.astro';

interface Props {
  item: TechStackItem;
}

const { item } = Astro.props;
---

<li class="tech-cell flex min-h-28 flex-col justify-between gap-4 bg-paper p-4 sm:p-5">
  <div class="flex h-9 items-center">
    {item.type === 'remote' ? (
      <img
        src={item.src}
        alt=""
        class:list={['tech-mark h-8 w-8 object-contain', isMonochromeIcon(item.src) && 'icon-mono']}
        width="32"
        height="32"
        loading="lazy"
        decoding="async"
      />
    ) : item.type === 'image' ? (
      <Image class:list={['tech-mark h-9 w-9 object-contain', item.imgClass]} src={item.src} alt="" loading="lazy" />
    ) : item.type === 'icon' ? (
      <StackIcon id={item.icon} class="tech-mark h-8 w-8 text-ink" />
    ) : (
      <span class="text-lg font-semibold tracking-tight text-ink" aria-hidden="true">{item.label}</span>
    )}
  </div>
  <p class:list={['text-sm font-medium text-ink', item.type === 'text' && 'sr-only']}>{item.label}</p>
</li>

<style>
  .tech-cell { transition: background-color .25s; }
  .tech-cell:hover { background: var(--surface); }
  .tech-mark { transition: transform .35s cubic-bezier(.22, 1, .36, 1), filter .2s; }
  @media (prefers-reduced-motion: no-preference) and (hover: hover) {
    .tech-cell:hover .tech-mark { transform: translateY(-2px) scale(1.06); }
  }
</style>
