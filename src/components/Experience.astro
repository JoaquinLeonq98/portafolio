---
import { education, experience, languages } from '../data/experience';
---

<section class="scroll-mt-24 border-t border-line py-16 md:py-24" id="experiencia" aria-labelledby="experiencia-heading">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div data-reveal class="mb-10 grid gap-x-16 gap-y-4 md:mb-14 lg:grid-cols-[1.1fr_1fr] lg:items-end">
      <h2 id="experiencia-heading" class="text-[clamp(2rem,4.2vw,3.5rem)] font-semibold leading-[1.04] tracking-[-0.03em] text-ink">
        Trayectoria
      </h2>
      <p class="max-w-[52ch] text-base leading-7 text-muted sm:text-lg sm:leading-8">
        Del mainframe bancario al producto a medida. El detalle está en el CV; aquí, el hilo de cada etapa.
      </p>
    </div>

    <ol class="border-t border-line">
      {experience.map((job, index) => (
        <li class="grid gap-6 border-b border-line py-10 lg:grid-cols-12 lg:gap-0">
          <div class="lg:col-span-5 lg:pr-14">
            <p class="text-sm tabular-nums text-folio">{String(index + 1).padStart(2, '0')}</p>
            <h3 class="mt-2 text-xl font-semibold tracking-[-0.02em] text-ink md:text-2xl">{job.org}</h3>
            <p class="mt-2 font-medium text-ink">{job.role}</p>
            <p class="mt-2 text-sm text-muted">
              <span class="tabular-nums">{job.period}</span>
              <span aria-hidden="true"> · </span>
              {job.place}
            </p>
          </div>
          <ul class="max-w-[62ch] space-y-3 text-base leading-7 text-muted lg:col-span-7 lg:border-l lg:border-line lg:pl-14">
            {job.points.map((point) => (
              <li class="flex gap-3">
                <span class="mt-[0.7rem] h-1 w-3 shrink-0 bg-accent" aria-hidden="true" />
                <span>{point}</span>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ol>

    <div class="mt-12 grid gap-8 border-t border-line pt-10 sm:grid-cols-2">
      <div>
        <h3 class="text-lg font-semibold text-ink">Formación</h3>
        <p class="mt-3 font-medium text-ink">{education.degree}</p>
        <p class="mt-1 text-muted">{education.school}</p>
        <p class="mt-1 text-sm text-muted">{education.period}</p>
      </div>
      <div>
        <h3 class="text-lg font-semibold text-ink">Idiomas</h3>
        <ul class="mt-3 space-y-2">
          {languages.map((lang) => (
            <li class="text-muted">
              <span class="font-medium text-ink">{lang.name}.</span>
              {lang.level}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
