---
import SectionHeading from './SectionHeading.astro';
import ProjectCarousel from './ProjectCarousel.astro';
---
<section class="scroll-mt-24 py-16 md:py-24" id="proyectos" aria-labelledby="proyectos-heading">
  <div class="mx-auto max-w-6xl px-5 sm:px-6">
    <SectionHeading compact title="Ideas llevadas a producto" eyebrow="Proyectos" id="proyectos-heading"
      subtitle="Sitios, aplicaciones y sistemas. Explora el contexto, las decisiones técnicas y el resultado de cada proyecto." />
    <ProjectCarousel />
  </div>
</section>
