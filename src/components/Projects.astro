---
import SectionHeading from './SectionHeading.astro';
import ProjectSpread from './ProjectSpread.astro';
import { projects } from '../data/projects';
---
<section class="scroll-mt-24 pt-16 md:pt-24" id="proyectos" aria-labelledby="proyectos-heading">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <SectionHeading title="Ideas llevadas a producto" id="proyectos-heading"
      subtitle="Sitios, aplicaciones y sistemas. Explora el contexto, las decisiones técnicas y el resultado de cada proyecto." />
    <div class="border-b border-line">
      {projects.map((project, index) => (
        <ProjectSpread project={project} number={index + 1} plateRight={index % 2 === 1} />
      ))}
    </div>
  </div>
</section>
