---
import { Image } from 'astro:assets';
import type { ProjectEntry } from '../data/projects';
import ProjectStatusBadge from './ProjectStatusBadge.astro';
import TechPills from './TechPills.astro';

interface Props {
  project: ProjectEntry;
  number: number;
  /** Lámina a la derecha del medianil (alterna entre pliegos). */
  plateRight?: boolean;
}

const { project, number, plateRight = false } = Astro.props;
const folio = String(number).padStart(2, '0');
const detailHref = `/proyectos/${project.slug}`;
const visitHref = project.href?.trim();
const cover = project.cover;
const preview = project.previewSrc?.trim();
const headingId = `obra-${project.slug}-titulo`;
---

<article
  id={`obra-${project.slug}`}
  class:list={['spread grid scroll-mt-24 border-t border-line py-12 md:py-16 lg:grid-cols-12 lg:gap-x-0', plateRight && 'spread--right']}
  aria-labelledby={headingId}
>
  <figure class="plate-wrap lg:col-span-7">
    <a href={detailHref} class="plate-link block" tabindex="-1" aria-hidden="true">
      <div
        data-plate
        class:list={[
          'plate relative aspect-[4/3] overflow-hidden rounded-[6px] border border-line',
          !cover && preview && project.previewFit === 'contain' ? project.previewContainerClass?.trim() || 'bg-surface' : 'bg-surface',
        ]}
      >
        {cover ? (
          typeof cover === 'string' ? (
            <img src={cover} alt="" width="1200" height="900" loading="lazy" decoding="async" class="plate-img absolute inset-0 h-full w-full object-cover object-top" />
          ) : (
            <Image src={cover} alt="" widths={[640, 960, 1280]} sizes="(min-width: 1024px) 56vw, 92vw" loading="lazy" class="plate-img absolute inset-0 h-full w-full object-cover object-top" />
          )
        ) : preview ? (
          <img
            src={preview}
            alt=""
            width="1200"
            height="900"
            loading="lazy"
            decoding="async"
            class:list={[
              'plate-img absolute',
              project.previewFit === 'contain'
                ? 'left-1/2 top-1/2 max-h-[58%] max-w-[62%] -translate-x-1/2 -translate-y-1/2 object-contain'
                : 'inset-0 h-full w-full object-cover object-top',
            ]}
          />
        ) : (
          <div class="absolute inset-0 grid place-items-center p-8">
            <p class="text-center text-[clamp(1.75rem,4vw,3.25rem)] font-semibold leading-none tracking-[-0.03em] text-line-strong">
              {project.title}
            </p>
          </div>
        )}
      </div>
    </a>
    <figcaption class="mt-3 flex gap-2 text-sm text-muted">
      <span class="text-folio">Lámina {folio}</span>
      <span aria-hidden="true">·</span>
      <span>{project.kind}</span>
    </figcaption>
  </figure>

  <div class="spread-text mt-8 lg:col-span-5 lg:mt-0 lg:flex lg:flex-col lg:justify-center">
    <div class="grid grid-cols-[2.75rem_1fr] gap-x-3 sm:grid-cols-[3.5rem_1fr]">
      <span class="pt-1 text-2xl font-light leading-none text-folio sm:text-3xl" aria-hidden="true">{folio}</span>
      <div class="min-w-0">
        <h3 id={headingId} class="text-[clamp(1.5rem,2.4vw,2.125rem)] font-semibold leading-[1.12] tracking-[-0.025em] text-ink">
          <a href={detailHref} class="spread-title-link">{project.title}</a>
        </h3>
        {project.inDevelopment && <ProjectStatusBadge class="mt-3" />}
        <p class="mt-4 max-w-[52ch] text-base leading-7 text-muted">{project.excerpt}</p>

        {project.tech.length > 0 && <TechPills tech={project.tech} max={6} class="mt-6" />}

        <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-1">
          <a href={detailHref} class="link-ink inline-flex min-h-11 items-center gap-1.5 text-[0.9375rem] font-medium">
            Ficha completa <span aria-hidden="true">→</span>
          </a>
          {visitHref && (
            <a href={visitHref} target="_blank" rel="noopener noreferrer" class="link-ink inline-flex min-h-11 items-center gap-1.5 text-[0.9375rem] font-medium">
              Visitar sitio <span aria-hidden="true">↗</span>
              <span class="sr-only">(se abre en otra pestaña)</span>
            </a>
          )}
        </div>
      </div>
    </div>
  </div>
</article>

<style>
  @media (min-width: 1024px) {
    .plate-wrap { padding-right: 3.5rem; border-right: 1px solid var(--line); }
    .spread-text { padding-left: 3.5rem; }
    .spread--right .plate-wrap { order: 2; padding-right: 0; padding-left: 3.5rem; border-right: 0; border-left: 1px solid var(--line); }
    .spread--right .spread-text { order: 1; padding-left: 0; padding-right: 3.5rem; }
  }
  .plate-img { transition: scale .7s cubic-bezier(.22, 1, .36, 1); }
  .spread-title-link { text-decoration-line: underline; text-decoration-color: transparent; text-decoration-thickness: 1px; text-underline-offset: 6px; transition: text-decoration-color .2s, color .2s; }
  .spread-title-link:hover { color: var(--accent); text-decoration-color: currentColor; }
  @media (prefers-reduced-motion: no-preference) and (hover: hover) {
    .spread:hover .plate-img { scale: 1.025; }
  }
</style>
