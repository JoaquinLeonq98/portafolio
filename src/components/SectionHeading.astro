---
interface Props { title: string; subtitle?: string; id?: string; }
const { title, subtitle, id } = Astro.props;
---
<div data-reveal class="mb-10 grid gap-x-16 gap-y-4 md:mb-14 lg:grid-cols-[1.1fr_1fr] lg:items-end">
  <h2 id={id} class="text-[clamp(2rem,4.2vw,3.5rem)] font-semibold leading-[1.04] tracking-[-0.03em] text-ink">{title}</h2>
  {subtitle && <p class="max-w-[52ch] text-base leading-7 text-muted sm:text-lg sm:leading-8">{subtitle}</p>}
</div>
