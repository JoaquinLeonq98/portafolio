---
interface Props { eyebrow?: string; title: string; subtitle?: string; id?: string; compact?: boolean; }
const { eyebrow, title, subtitle, id, compact = false } = Astro.props;
---
<div data-reveal class:list={['max-w-2xl', compact ? 'mb-8' : 'mb-10 md:mb-12']}>
  {eyebrow && <p class="mb-3 text-sm font-medium text-sky-300">{eyebrow}</p>}
  <h2 id={id} class="text-3xl font-semibold tracking-tight text-white sm:text-4xl">{title}</h2>
  {subtitle && <p class="mt-4 text-base leading-7 text-slate-400 sm:text-lg">{subtitle}</p>}
</div>
