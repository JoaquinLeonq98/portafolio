---
import { Image } from 'astro:assets';
import JoaquinPerfil from '../assets/JoaquinPerfil.jpg';
const cvFile = 'CV-JOAQUÍN LEÓN QUERO.docx.pdf';
const cvHref = `/${encodeURIComponent(cvFile)}`;
---
<section id="inicio" class="relative scroll-mt-24 overflow-hidden border-b border-white/10" aria-labelledby="hero-title">
  <div class="hero-layout mx-auto grid max-w-6xl items-center gap-12 px-5 py-14 sm:px-6 md:py-20 lg:gap-20">
    <div data-hero-copy>
      <p class="mb-7 flex items-center gap-2.5 text-sm text-sky-300">
        <span class="h-2 w-2 shrink-0 rounded-full bg-sky-400" aria-hidden="true"></span>
        Disponible para proyectos y colaboraciones
      </p>
      <h1 id="hero-title" class="text-[clamp(2.6rem,5vw,4.5rem)] leading-[1.06] font-semibold tracking-[-0.055em] text-white">
        Joaquín<br />León Quero<span class="text-sky-400">.</span>
      </h1>
      <p class="mt-5 text-lg font-medium text-slate-200 sm:text-xl">Ingeniero en Gestión de TI &amp; Full-stack</p>
      <p class="mt-5 max-w-lg text-base leading-7 text-slate-400 sm:text-lg sm:leading-8">
        Desarrollo productos web, conecto sistemas y los llevo a producción.
        Más de cinco años en TI, con experiencia en banca y producto digital.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#proyectos" class="button-primary">Explorar proyectos
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M12 5v14m-6-6 6 6 6-6" /></svg>
        </a>
        <a href={cvHref} download={cvFile} class="button-secondary">Descargar CV
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M12 3v12m-4-4 4 4 4-4M5 16v4h14v-4" /></svg>
        </a>
      </div>
      <a href="#contacto" class="mt-4 inline-flex min-h-11 items-center text-sm text-slate-400 underline-offset-4 hover:text-sky-300 hover:underline">¿Tienes un proyecto? Hablemos.</a>
    </div>
    <figure data-hero-portrait class="portrait relative mx-auto w-full max-w-sm lg:justify-self-end">
      <div class="overflow-hidden rounded-t-[6rem] rounded-b-2xl border border-white/10 bg-slate-900">
        <Image src={JoaquinPerfil} alt="Joaquín León Quero" class="aspect-[4/4.5] w-full object-cover object-top"
          widths={[320, 480, 768]} sizes="(max-width: 640px) 85vw, 384px" loading="eager" fetchpriority="high" />
        <figcaption class="flex items-center justify-between gap-4 border-t border-white/10 px-6 py-5">
          <div><p class="text-sm font-medium text-white">Querétaro, México</p><p class="mt-1 text-xs text-slate-400">Cofundador de Tridot México</p></div>
          <svg class="text-violet-400" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20 10c0 6-8 11-8 11S4 16 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg>
        </figcaption>
      </div>
    </figure>
  </div>
  <div data-reveal-group class="mx-auto grid max-w-6xl gap-5 border-t border-white/10 px-5 py-6 sm:grid-cols-3 sm:px-6">
    <p class="text-sm text-slate-400"><span class="mb-1 block font-medium text-slate-200">Producto completo</span>Web, backend y despliegue</p>
    <p class="text-sm text-slate-400"><span class="mb-1 block font-medium text-slate-200">Experiencia en banca</span>Calidad y procesos exigentes</p>
    <p class="text-sm text-slate-400"><span class="mb-1 block font-medium text-slate-200">Colaboración directa</span>Español nativo e inglés técnico B1</p>
  </div>
</section>
<style>
  #inicio { background: radial-gradient(ellipse at 85% 25%, #312e811f, transparent 55%); }
  @media (min-width: 768px) { .hero-layout { grid-template-columns: 1.35fr 1fr; } }
  @media (max-width: 767px) { .portrait { max-width: 20rem; } }
</style>
