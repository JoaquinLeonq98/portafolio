---
import { projects } from '../data/projects';

const cvFile = 'CV_Joaquin_Leon_2026_ES.pdf';
const cvHref = `/${cvFile}`;
---
<section id="inicio" class="scroll-mt-24 border-b border-line" aria-labelledby="hero-title">
  <div class="title-spread mx-auto grid max-w-7xl px-5 sm:px-8">
    <div data-hero-copy class="title-page flex flex-col justify-center py-14 md:py-20 lg:pr-16">
      <h1 id="hero-title" class="text-[clamp(2.75rem,6.4vw,5.75rem)] font-semibold leading-[.98] tracking-[-0.035em] text-ink">
        Joaquín<br />León Quero<span class="text-accent">.</span>
      </h1>
      <p class="mt-6 text-lg font-medium text-ink sm:text-xl">Desarrollador full-stack · Automatización con agentes de IA</p>
      <p class="mt-4 max-w-[46ch] text-base leading-7 text-muted sm:text-lg sm:leading-8">
        NestJS, Next.js, Node.js y TypeScript. Cofundador de Tridot México.
        Plataformas a medida, banca y automatización con revisión humana.
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href="#proyectos" class="button-primary">Explorar proyectos
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M12 5v14m-6-6 6 6 6-6" /></svg>
        </a>
        <a href={cvHref} download={cvFile} class="button-secondary">Descargar CV
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M12 3v12m-4-4 4 4 4-4M5 16v4h14v-4" /></svg>
        </a>
      </div>
      <p class="mt-7 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted">
        <span class="inline-flex items-center gap-2">
          <span class="h-2 w-2 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
          Disponible para proyectos y colaboraciones
        </span>
        <a href="#contacto" class="link-ink inline-flex min-h-11 items-center">¿Tienes un proyecto? Hablemos.</a>
      </p>
    </div>

    <nav class="index-page py-10 md:py-20 lg:pl-16" aria-labelledby="indice-heading">
      <h2 id="indice-heading" class="text-base font-semibold text-ink">Índice de obras</h2>
      <ol class="mt-5 border-t border-line">
        {projects.map((project, index) => (
          <li class="border-b border-line">
            <a href={`#obra-${project.slug}`} class="index-row group grid min-h-14 grid-cols-[2.25rem_1fr_auto] items-baseline gap-x-3 py-3.5">
              <span class="text-sm text-folio">{String(index + 1).padStart(2, '0')}</span>
              <span class="min-w-0">
                <span class="index-title block text-[1.0625rem] font-medium leading-snug text-ink">{project.title}</span>
                <span class="mt-0.5 block text-sm text-muted">{project.kind}</span>
              </span>
              {project.inDevelopment ? (
                <span class="flex items-center gap-1.5 text-xs font-medium text-pending">
                  <span class="h-1.5 w-1.5 rounded-full bg-pending" aria-hidden="true"></span>
                  <span class="hidden sm:inline">En desarrollo</span>
                  <span class="sr-only sm:hidden">En desarrollo</span>
                </span>
              ) : (
                <span class="index-arrow text-muted" aria-hidden="true">↓</span>
              )}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </div>

  <div data-reveal-group class="colophon mx-auto grid max-w-7xl gap-5 border-t border-line px-5 py-6 sm:grid-cols-3 sm:px-8">
    <p class="text-sm text-muted"><span class="mb-1 block font-medium text-ink">Producto completo</span>Web, backend y despliegue</p>
    <p class="text-sm text-muted"><span class="mb-1 block font-medium text-ink">Experiencia en banca</span>Calidad y procesos exigentes</p>
    <p class="text-sm text-muted"><span class="mb-1 block font-medium text-ink">Colaboración directa</span>Español nativo e inglés técnico B1</p>
  </div>
</section>

<style>
  @media (min-width: 1024px) {
    .title-spread { grid-template-columns: 1.1fr 1fr; }
    .index-page { border-left: 1px solid var(--line); display: flex; flex-direction: column; justify-content: center; }
  }
  .index-title { text-decoration-line: underline; text-decoration-color: transparent; text-underline-offset: 5px; transition: color .2s, text-decoration-color .2s; }
  .index-row:hover .index-title, .index-row:focus-visible .index-title { color: var(--accent); text-decoration-color: currentColor; }
  .index-arrow { transition: transform .25s cubic-bezier(.22, 1, .36, 1), color .2s; }
  .index-row:hover .index-arrow { color: var(--accent); transform: translateY(3px); }
</style>
