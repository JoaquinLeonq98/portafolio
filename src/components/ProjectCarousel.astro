---
import ProjectCard from './ProjectCard.astro';
import { projects } from '../data/projects';

const columnCount = Math.ceil(projects.length / 2);
// Las copias permiten cruzar ambos extremos sin saltos visibles.
const copies = [0, 1, 2];
---
<div data-reveal class="projects-showcase" data-carousel data-column-count={columnCount} data-project-count={projects.length} style={`--columns: ${columnCount}`}>
  <div class="carousel-toolbar">
    <p class="text-sm text-slate-400">Desliza para explorar <span class="hidden sm:inline">mis proyectos</span></p>
    <div class="flex items-center gap-3" data-carousel-controls hidden>
      <span class="min-w-12 text-center text-sm tabular-nums text-slate-400" data-carousel-position aria-hidden="true">1 / {columnCount}</span>
      <button type="button" class="carousel-control" data-carousel-prev aria-label="Proyecto anterior" aria-controls="project-carousel-viewport">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m14 6-6 6 6 6M8 12h12" /></svg>
      </button>
      <button type="button" class="carousel-control" data-carousel-next aria-label="Proyecto siguiente" aria-controls="project-carousel-viewport">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m10 6 6 6-6 6M16 12H4" /></svg>
      </button>
    </div>
  </div>
  <div id="project-carousel-viewport" class="carousel-viewport" data-carousel-viewport tabindex="0" role="region" aria-label="Proyectos" aria-roledescription="carrusel">
    <div class="carousel-track" data-carousel-track>
      {copies.map(copy => projects.map((project, index) => (
        <div class="carousel-slide" data-copy={copy} data-project={index}
          style={`--copy: ${copy}; --column: ${index % columnCount}; --row: ${Math.floor(index / columnCount) + 1}`}
          aria-hidden={copy !== 1 ? 'true' : undefined} inert={copy !== 1}>
          <ProjectCard {...project} />
        </div>
      )))}
    </div>
  </div>
  <div class="carousel-pagination" data-carousel-controls hidden role="group" aria-label="Elegir proyectos">
    {projects.map((_, index) => <button type="button" class="carousel-dot" data-carousel-dot={index} aria-label={`Ir a columna ${index + 1}`} aria-current={index === 0 ? 'true' : undefined} aria-controls="project-carousel-viewport"><span /></button>)}
  </div>
  <p class="sr-only" data-carousel-status role="status" aria-atomic="true"></p>
</div>
<style>
  .carousel-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: .25rem; }
  .carousel-control { display: grid; place-items: center; width: 46px; height: 46px; border: 1px solid #334155; border-radius: 50%; color: #e2e8f0; background: #0f172a80; transition: transform .22s, background .22s, border-color .22s, box-shadow .22s; }
  .carousel-control:hover, .carousel-control:focus-visible { border-color: #38bdf8; background: #38bdf81a; color: #7dd3fc; box-shadow: 0 0 22px #38bdf818; }
  .carousel-control:active { transform: scale(.93); }
  .carousel-viewport { container-type: inline-size; overflow-x: auto; padding-block: 1rem 1.5rem; scroll-snap-type: x mandatory; scrollbar-width: thin; scrollbar-color: #334155 transparent; }
  .carousel-track { display: grid; grid-auto-flow: column; grid-auto-columns: 100cqw; gap: 1.25rem; }
  .carousel-slide { min-width: 0; scroll-snap-align: start; }
  .carousel-slide[data-copy]:not([data-copy='1']) { display: none; }
  [data-ready] .carousel-slide { display: block; }
  [data-ready] .carousel-viewport { overflow: hidden; touch-action: pan-y pinch-zoom; scroll-snap-type: none; }
  [data-ready] .carousel-track { will-change: transform; }
  [data-dragging] { cursor: grabbing; user-select: none; }
  .carousel-pagination { display: flex; justify-content: center; gap: 0; }
  .carousel-dot { display: grid; place-items: center; width: 44px; height: 44px; min-width: 0; border-radius: 50%; }
  .carousel-dot span { display: block; width: 7px; height: 7px; border-radius: 100%; background: #64748b; transition: transform .25s, background .25s, box-shadow .25s; }
  .carousel-dot:hover span { background: #c4b5fd; transform: scale(1.4); }
  .carousel-dot[aria-current='true'] span { background: #38bdf8; transform: scale(1.6); box-shadow: 0 0 14px #38bdf855; }
  @container (min-width: 640px) {
    .carousel-track { grid-template-rows: repeat(2, 1fr); grid-auto-columns: calc((100cqw - 1.25rem) / 2); }
    .carousel-slide { grid-row: var(--row); grid-column: calc(var(--column) + 1); }
    [data-ready] .carousel-slide { grid-column: calc(var(--copy) * var(--columns) + var(--column) + 1); }
  }
  @container (min-width: 1024px) { .carousel-track { grid-auto-columns: calc((100cqw - 2.5rem) / 3); } }
  @media (max-width: 479px) { .carousel-toolbar { align-items: flex-start; } .carousel-toolbar > p { max-width: 10rem; padding-top: .75rem; } }
</style>
<script>
  import { gsap } from 'gsap';

  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach(root => {
    const viewport = root.querySelector<HTMLElement>('[data-carousel-viewport]')!;
    const track = root.querySelector<HTMLElement>('[data-carousel-track]')!;
    const slides = [...root.querySelectorAll<HTMLElement>('.carousel-slide')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-carousel-dot]')];
    const projectCount = Number(root.dataset.projectCount);
    const columnCount = Number(root.dataset.columnCount);
    if (!projectCount) return;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let count = projectCount;
    let index = count;
    let stepSize = 0;
    let visibleCount = 1;
    let desktop = false;
    let lastWidth = 0;
    let animation: gsap.core.Tween | undefined;
    let pointer: { id: number; x: number; y: number; delta: number } | undefined;
    let dragged = false;
    const offset = () => -index * stepSize;
    const currentIndex = () => ((index - count) % count + count) % count;
    const normalize = () => { index = count + currentIndex(); };

    function updateAccess(announce = false) {
      slides.forEach(slide => {
        const project = Number(slide.dataset.project);
        const position = Number(slide.dataset.copy) * count + (desktop ? project % columnCount : project);
        const visible = position >= index && position < index + visibleCount;
        slide.inert = !visible;
        if (visible) slide.removeAttribute('aria-hidden');
        else slide.setAttribute('aria-hidden', 'true');
      });
      const current = currentIndex();
      dots.forEach((dot, position) => {
        if (position >= count && document.activeElement === dot) viewport.focus({ preventScroll: true });
        dot.hidden = position >= count;
        dot.setAttribute('aria-label', desktop ? `Ir a columna ${position + 1}` : `Ver proyecto: ${slides[position].querySelector('h3')!.textContent!.trim()}`);
        if (position === current) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
      root.querySelector('[data-carousel-position]')!.textContent = `${current + 1} / ${count}`;
      viewport.setAttribute('aria-label', desktop ? 'Proyectos en dos filas' : 'Proyectos, desliza para explorar');
      if (announce) {
        root.querySelector('[data-carousel-status]')!.textContent = desktop
          ? `Columna ${current + 1} de ${count}`
          : `Proyecto ${current + 1} de ${count}: ${slides[current].querySelector('h3')!.textContent!.trim()}`;
      }
    }

    function focusViewport() {
      if (track.contains(document.activeElement)) viewport.focus({ preventScroll: true });
    }

    function refresh(force = false) {
      const width = viewport.clientWidth;
      if (!force && width === lastWidth) return;
      lastWidth = width;
      animation?.kill();
      animation = undefined;
      track.inert = false;
      if (pointer && viewport.hasPointerCapture(pointer.id)) viewport.releasePointerCapture(pointer.id);
      pointer = undefined;
      root.removeAttribute('data-dragging');
      const current = currentIndex();
      desktop = width >= 640;
      count = desktop ? columnCount : projectCount;
      index = count + current % count;
      stepSize = slides[0].getBoundingClientRect().width + parseFloat(getComputedStyle(track).columnGap);
      visibleCount = Math.min(count, Math.max(1, Math.round((width + 20) / stepSize)));
      focusViewport();
      gsap.set(track, { x: offset() });
      updateAccess();
    }

    function move(delta: number) {
      if (animation || !stepSize) return;
      focusViewport();
      index += delta;
      const finish = () => {
        animation = undefined;
        track.inert = false;
        normalize();
        gsap.set(track, { x: offset() });
        updateAccess(true);
      };
      if (reducedMotion.matches) { finish(); return; }
      track.inert = true;
      animation = gsap.to(track, { x: offset(), duration: .55, ease: 'power3.out', onComplete: finish });
    }

    root.dataset.ready = '';
    viewport.scrollLeft = 0;
    root.querySelectorAll<HTMLElement>('[data-carousel-controls]').forEach(control => { control.hidden = false; });
    root.querySelector('[data-carousel-prev]')!.addEventListener('click', () => move(-1));
    root.querySelector('[data-carousel-next]')!.addEventListener('click', () => move(1));
    dots.forEach((dot, target) => dot.addEventListener('click', () => move(target - currentIndex())));
    viewport.addEventListener('keydown', event => {
      const delta = event.key === 'ArrowLeft' ? -1 : event.key === 'ArrowRight' ? 1 : event.key === 'Home' ? -currentIndex() : event.key === 'End' ? count - 1 - currentIndex() : null;
      if (delta === null) return;
      event.preventDefault();
      move(delta);
    });
    viewport.addEventListener('dragstart', event => event.preventDefault());
    viewport.addEventListener('pointerdown', event => {
      if (animation || !event.isPrimary || event.button !== 0) return;
      dragged = false;
      pointer = { id: event.pointerId, x: event.clientX, y: event.clientY, delta: 0 };
    });
    viewport.addEventListener('pointermove', event => {
      if (!pointer || pointer.id !== event.pointerId) return;
      const delta = event.clientX - pointer.x;
      if (!dragged && (Math.abs(delta) < 10 || Math.abs(delta) < Math.abs(event.clientY - pointer.y))) return;
      dragged = true;
      pointer.delta = Math.max(-stepSize, Math.min(stepSize, delta));
      viewport.setPointerCapture(event.pointerId);
      root.dataset.dragging = '';
      gsap.set(track, { x: offset() + pointer.delta });
    });
    function endDrag(event: PointerEvent) {
      if (!pointer || pointer.id !== event.pointerId) return;
      const delta = pointer.delta;
      pointer = undefined;
      root.removeAttribute('data-dragging');
      if (viewport.hasPointerCapture(event.pointerId)) viewport.releasePointerCapture(event.pointerId);
      if (dragged) move(event.type === 'pointercancel' || Math.abs(delta) < 45 ? 0 : delta < 0 ? 1 : -1);
    }
    viewport.addEventListener('pointerup', endDrag);
    viewport.addEventListener('pointercancel', endDrag);
    viewport.addEventListener('click', event => {
      if (dragged) { event.preventDefault(); event.stopPropagation(); dragged = false; }
    }, true);
    reducedMotion.addEventListener('change', () => refresh(true));
    new ResizeObserver(() => refresh()).observe(viewport);
    refresh(true);
  });
</script>
